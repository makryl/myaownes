{
  "version": 3,
  "configurePresets": [
    {
      "name": "Base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/dist/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "Debug",
      "hidden": true,
      "inherits": ["Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "RelWithDebInfo",
      "hidden": true,
      "inherits": ["Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "Release",
      "hidden": true,
      "inherits": ["Base"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": true
      }
    },
    {
      "name": "Clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang"
      }
    },
    {
      "name": "Emscripten",
      "hidden": true,
      "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
      "cacheVariables": {
        "CMAKE_C_FLAGS": "-D__EMSCRIPTEN__",
        "SDL_EMSCRIPTEN_PERSISTENT_PATH": "/storage"
      }
    },
    {
      "name": "MinGW",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_C_COMPILER": "x86_64-w64-mingw32-gcc",
        "CMAKE_CXX_COMPILER": "x86_64-w64-mingw32-g++",
        "CMAKE_CROSSCOMPILING_EMULATOR": "wine"
      }
    },
    {
      "name": "MacOS",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64;arm64"
      }
    },
    {
      "name": "Clang-Debug",
      "inherits": ["Clang", "Debug"]
    },
    {
      "name": "Clang-RelWithDebInfo",
      "inherits": ["Clang", "RelWithDebInfo"]
    },
    {
      "name": "Clang-Release",
      "inherits": ["Clang", "Release"]
    },
    {
      "name": "Linux-Debug",
      "inherits": ["Debug"]
    },
    {
      "name": "Linux-RelWithDebInfo",
      "inherits": ["RelWithDebInfo"]
    },
    {
      "name": "Linux-Release",
      "inherits": ["Release"]
    },
    {
      "name": "Emscripten-Debug",
      "inherits": ["Emscripten", "Debug"]
    },
    {
      "name": "Emscripten-RelWithDebInfo",
      "inherits": ["Emscripten", "RelWithDebInfo"]
    },
    {
      "name": "Emscripten-Release",
      "inherits": ["Emscripten", "Release"]
    },
    {
      "name": "Windows-Debug",
      "inherits": ["MinGW", "Debug"]
    },
    {
      "name": "Windows-RelWithDebInfo",
      "inherits": ["MinGW", "RelWithDebInfo"]
    },
    {
      "name": "Windows-Release",
      "inherits": ["MinGW", "Release"]
    },
    {
      "name": "MacOS-Release",
      "inherits": ["MacOS", "Release"]
    }
  ]
}
